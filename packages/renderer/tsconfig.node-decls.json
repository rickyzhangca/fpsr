{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": false,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@rickyzhangca/fpsr": ["./dist/index.d.ts"],
      "@rickyzhangca/fpsr/*": ["./dist/*.d.ts"]
    }
  },
  "include": ["scripts/node-decls-check.ts"],
  "exclude": ["src", "test", "dist"]
}
