{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"],
      "fpsr": ["../../packages/renderer/src/index.ts"],
      "fpsr/planner": ["../../packages/renderer/src/planner.ts"],
      "fpsr/canvas": ["../../packages/renderer/src/canvas.ts"],
      "fpsr/render-db": ["../../packages/renderer/src/render-db.ts"],
      "fpsr/node": ["../../packages/renderer/src/node.ts"],
      "fpsr-internal/prepared-viewport": [
        "../../packages/renderer/src/internal/prepared-viewport.ts"
      ]
    }
  },
  "include": ["src"]
}
