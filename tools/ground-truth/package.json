{
  "name": "@fpsr/ground-truth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "shoot": "tsx src/cli.ts",
    "refresh": "tsx src/refresh.ts",
    "suite:audit": "tsx src/base-suite-cli.ts --audit --canary",
    "suite:canary": "tsx src/base-suite-cli.ts --capture --compare --canary",
    "suite:all": "tsx src/base-suite-cli.ts --capture --compare --all",
    "suite:official:audit": "tsx src/base-suite-cli.ts --audit --canary --suite fixtures/visual-tests/official-mods --assets assets-out/2.1.11",
    "suite:official:canary": "tsx src/base-suite-cli.ts --capture --compare --canary --suite fixtures/visual-tests/official-mods --assets assets-out/2.1.11",
    "suite:official:all": "tsx src/base-suite-cli.ts --capture --compare --all --suite fixtures/visual-tests/official-mods --assets assets-out/2.1.11",
    "build": "echo 'no build step'",
    "test": "vp test run",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit",
    "format": "vp fmt"
  },
  "dependencies": {
    "fpsr": "workspace:*",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "skia-canvas": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
