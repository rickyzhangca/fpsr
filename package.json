{
  "name": "fpsr-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vp run -F './packages/*' -F './apps/*' -F './tools/*' build",
    "test": "vp run -F './packages/*' -F './apps/*' -F './tools/*' --concurrency-limit 1 test",
    "lint": "vp lint --deny-warnings",
    "typecheck": "pnpm -F fpsr build && vp run -F './packages/*' -F './apps/*' -F './tools/*' typecheck",
    "format": "vp fmt",
    "check": "node scripts/check-filenames.mjs && node scripts/check-module-size.mjs && vp fmt --check && pnpm lint && pnpm typecheck",
    "dev": "vp dev apps/viewer",
    "goldens:update": "vp run -F @fpsr/golden-tests update",
    "goldens:test": "vp run -F @fpsr/golden-tests test:golden",
    "ground-truth:refresh": "pnpm -F @fpsr/ground-truth run refresh",
    "visual-tests:audit": "pnpm -F @fpsr/ground-truth run suite:audit",
    "visual-tests:canary": "pnpm -F @fpsr/ground-truth run suite:canary",
    "visual-tests:all": "pnpm -F @fpsr/ground-truth run suite:all",
    "visual-tests:generate:official": "pnpm -F @fpsr/corpus run generate:official-mods",
    "visual-tests:official:audit": "pnpm -F @fpsr/ground-truth run suite:official:audit",
    "visual-tests:official:canary": "pnpm -F @fpsr/ground-truth run suite:official:canary",
    "visual-tests:official:all": "pnpm -F @fpsr/ground-truth run suite:official:all",
    "assets:build": "pnpm -F @fpsr/pipeline run pipeline all",
    "assets:build:base": "pnpm -F @fpsr/pipeline run pipeline all --mods base",
    "assets:verify": "pnpm -F @fpsr/pipeline run pipeline verify",
    "assets:bench": "pnpm -F @fpsr/pipeline run pipeline bench",
    "renderer:bench-thread": "pnpm -F @fpsr/render-cli run bench:thread"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.17.0"
}
